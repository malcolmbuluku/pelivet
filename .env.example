# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Flask — generate a long random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database (default is SQLite in instance/pelivet.db). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/pelivet
# DATABASE_URL=

# Clinic details — shown across the site, no code changes needed
CLINIC_NAME=PELIVET Veterinary Clinic
CLINIC_PHONE=+254 700 000 000
CLINIC_EMERGENCY=+254 711 111 111
CLINIC_EMAIL=hello@pelivet.co.ke
CLINIC_ADDRESS=[Your street address], Nairobi
CLINIC_MAPS_QUERY=PELIVET Veterinary Clinic, Nairobi

# Admin login (change the password before going live!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Email notifications (optional). Leave MAIL_SERVER blank to disable —
# submissions are still saved to the database and shown in the admin.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_NOTIFY_TO=hello@pelivet.co.ke
